# Admin area password (required in production)
ADMIN_PASSWORD=changeme
# Secret used to sign the admin session cookie
ADMIN_SECRET=replace-with-a-long-random-string

# SMTP settings for enquiry notification emails.
# If SMTP_HOST is empty, emails are written to data/runtime/outbox instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Website <no-reply@example.com>"
SALES_INBOX=sales@example.com
